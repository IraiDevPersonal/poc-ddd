{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@post/*": ["./src/post/*"],
      "@styles/*": ["./src/styles/*"],
      "@shared/*": ["./src/shared/*"]
    }
  }
}
