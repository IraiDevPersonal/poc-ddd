---
import type { PostDetailItemProps } from "../application/schemas";

type Props = {
  post: PostDetailItemProps;
};

const { post } = Astro.props;
---

<main class="p-4 container mx-auto flex flex-col gap-y-4">
  <h1 class="text-5xl font-bold">{post.title}</h1>
  <h5 class="text-2xl font-medium">post id: {post.postId}</h5>
  <h5 class="text-2xl font-medium">user id: {post.userId}</h5>
  <p class="text-base">{post.content}</p>
</main>
