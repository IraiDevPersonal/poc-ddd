---
import { postContainer, PostDetail, type PostDetailProps } from "@/post";
import { RootLayout } from "@/shared";

type Props = {
  post: PostDetailProps;
};

export async function getStaticPaths() {
  return await postContainer.getPostsDetailsStaticPaths();
}

const { post } = Astro.props;
---

<RootLayout title={`Post ${post.postId}`}>
  <PostDetail post={post} />
</RootLayout>
