---
import {
  getPostsDetailsStaticPaths,
  PostDetail,
  type PostDetailProps,
} from "@/post";
import RootLayout from "@/shared/components/layouts/RootLayout.astro";

type Props = {
  post: PostDetailProps;
};

export async function getStaticPaths() {
  return await getPostsDetailsStaticPaths();
}

const { post } = Astro.props;
---

<RootLayout title={`Post ${post.postId}`}>
  <PostDetail post={post} />
</RootLayout>
