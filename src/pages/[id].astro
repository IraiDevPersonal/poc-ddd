---
import type { GetStaticPaths } from "astro";
import RootLayout from "@/shared/components/layouts/RootLayout.astro";
import type { PostDetail } from "@/post/types/post.type";
import PostDetailComponent from "@/post/components/PostDetail.astro";
import { getPostDetails } from "@/post/services/post.service";

type Props = {
  post: PostDetail;
};

export const getStaticPaths = (async () => {
  const posts = await getPostDetails();

  return posts.map((post) => ({
    params: { id: post.postId.toString() },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
---

<RootLayout title={`Post ${post.postId}`}>
  <PostDetailComponent post={post} />
</RootLayout>
