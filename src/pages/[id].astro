---
import type { PostDetailProps } from "@/post";
import { PostDetailComponent } from "@/post";
import { getPostsDetailsStaticPaths } from "@/post/services/post.helpers";
import RootLayout from "@/shared/components/layouts/RootLayout.astro";

type Props = {
  post: PostDetailProps;
};

export async function getStaticPaths() {
  return await getPostsDetailsStaticPaths();
}

const { post } = Astro.props;
---

<RootLayout title={`Post ${post.postId}`}>
  <PostDetailComponent post={post} />
</RootLayout>
