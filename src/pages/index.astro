---
import RootLayout from "@/shared/components/layouts/RootLayout.astro";
import { getPostsList, PostList } from "@/post";

const posts = await getPostsList();
---

<RootLayout title="Posts">
  <header
    class="sticky top-0 bg-amber-900/40 backdrop-blur-md border-amber-800 border-b"
  >
    <div class="container mx-auto p-4">
      <h1 class="text-5xl font-bold">Posts ({posts.length})</h1>
    </div>
  </header>
  <main class="container mx-auto flex-1 my-10">
    <PostList posts={posts} />
  </main>
</RootLayout>
